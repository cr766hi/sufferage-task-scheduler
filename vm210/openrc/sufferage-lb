#!/sbin/openrc-run

name="Sufferage HTTP load balancer"
description="Run the Sufferage load balancer on port 80"
supervisor="supervise-daemon"
command="/usr/local/sbin/run-sufferage-lb"
pidfile="/run/${RC_SVCNAME}.pid"
required_files="/opt/sufferage-lb/lb.py /usr/bin/python3"
output_log="/var/log/sufferage-lb/service.log"
error_log="/var/log/sufferage-lb/error.log"
respawn_delay=3
respawn_max=5
respawn_period=60
retry="TERM/15/KILL/5"

depend() {
    need localmount net
}

start_pre() {
    checkpath --directory --mode 0750 --owner root:root /var/log/sufferage-lb
}
